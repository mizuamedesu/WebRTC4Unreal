# Never commit the real developer credential. Copy this file to .env locally.
HCF_DEVELOPER_CREDENTIAL=hcf_replace_me
HCF_PRINCIPAL_ID=0198a118-073f-79e4-9ca4-0c1c2501c031

# Loopback is safe for one-PC testing. For LAN clients use 0.0.0.0 and set a key.
P2P_BIND_HOST=127.0.0.1
P2P_BACKEND_PORT=8787
P2P_BOOTSTRAP_KEY=
P2P_RATE_LIMIT_PER_MINUTE=20

FLOW_API_BASE_URL=https://flow.heterocloud.mizuame.app
HCF_CREDENTIAL_ENDPOINT=https://heterocloud.mizuame.app/api/v1/flow/v1/access-credentials
FLOW_TOKEN_TTL_SECONDS=300
